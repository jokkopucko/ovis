+++ b/crates/hc-tui/src/app/mod_tests/blind_input.rs
@@ -0,0 +1,35 @@
+// Added by Ovis (https://github.com/devswha/ovis) for programs that embed this client.
+use super::*;
+
+#[tokio::test]
+async fn input_queued_before_a_recovered_paint_is_refused_and_the_rest_still_handled() {
+    let mut app = app_with_spaces(&[("t1", "work")]);
+    app.pane.set_discard_input_on_recovery(true);
+    app.pane.mark_recovered_paint();
+    let (tx, mut events) = mpsc::channel(8);
+    tx.send(UiEvent::Paste(b"typed blind".to_vec()))
+        .await
+        .unwrap();
+    tx.send(UiEvent::Text("x".into())).await.unwrap();
+    tx.send(UiEvent::Resize { cols: 91, rows: 33 })
+        .await
+        .unwrap();
+    app.drop_input_typed_blind(&mut events);
+    assert!(events.try_recv().is_err());
+    assert_eq!(app.area, (91, 33));
+    assert!(app.pane.take_input_rejection().is_some());
+    assert_eq!(app.pane.input_backlog().0, 0);
+}
+
+#[tokio::test]
+async fn without_a_recovered_paint_queued_input_is_left_for_the_loop() {
+    let mut app = app_with_spaces(&[("t1", "work")]);
+    app.pane.set_discard_input_on_recovery(true);
+    let (tx, mut events) = mpsc::channel(8);
+    tx.send(UiEvent::Paste(b"typed now".to_vec()))
+        .await
+        .unwrap();
+    app.drop_input_typed_blind(&mut events);
+    assert!(matches!(events.try_recv(), Ok(UiEvent::Paste(_))));
+    assert!(app.pane.take_input_rejection().is_none());
+}
