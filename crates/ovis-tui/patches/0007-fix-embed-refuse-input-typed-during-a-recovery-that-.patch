diff --git a/crates/hc-tui/src/app/embed.rs b/crates/hc-tui/src/app/embed.rs
index 99ad35b..7ea2dd8 100644
--- a/crates/hc-tui/src/app/embed.rs
+++ b/crates/hc-tui/src/app/embed.rs
@@ -4,6 +4,28 @@
 use super::*;
 
 impl App {
+    /// After a recovered terminal's first paint under the input policy,
+    /// keys, text, pastes and mouse input still waiting in the reader's
+    /// queue were typed while the terminal was down: they are refused like
+    /// it and never sent. Anything else waiting there is handled as usual.
+    pub(super) fn drop_input_typed_blind(&mut self, events: &mut mpsc::Receiver<UiEvent>) {
+        if !self.pane.take_recovered_paint() {
+            return;
+        }
+        let mut dropped = 0;
+        while let Ok(event) = events.try_recv() {
+            match event {
+                UiEvent::Key(_) | UiEvent::Text(_) | UiEvent::Paste(_) | UiEvent::Mouse(_) => {
+                    dropped += 1;
+                }
+                other => self.on_input(other, self.area.0),
+            }
+        }
+        if dropped > 0 {
+            self.pane.refuse_blind_input(dropped);
+        }
+    }
+
     /// Every pane made from now on starts with this recovery policy.
     pub fn discard_input_on_recovery(on: bool) {
         pane::default_discard_input_on_recovery(on);
