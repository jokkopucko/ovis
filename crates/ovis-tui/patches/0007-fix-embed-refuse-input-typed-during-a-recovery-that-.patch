+    /// Whether a recovered wire painted its first screen under the policy
+    /// since the last call: input the app had queued by then was typed
+    /// while the terminal was down.
+    pub(crate) fn take_recovered_paint(&mut self) -> bool {
+        std::mem::take(&mut self.recovered_paint)
+    }
+
+    /// `count` inputs the app dropped for that reason: refused like input
+    /// typed while the wire is down, with the same notice.
+    pub(crate) fn refuse_blind_input(&mut self, count: u64) {
+        self.dropped_input += count;
+        self.input_rejection = Some("Terminal is reconnecting: this input was not sent".into());
+    }
+
+    #[cfg(test)]
+    pub(crate) fn mark_recovered_paint(&mut self) {
+        self.recovered_paint = true;
+    }
