<?xml version="1.0" encoding="utf-8"?>
<!-- The preview build alone (build type "preview") installs its own updates: PreviewUpdater hands the APK it
     downloaded from its feed to the system installer. No store build asks for this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
