@@ -2530,7 +2530,11 @@ pub fn carriageReturn(self: *Terminal) void {
 
 /// Linefeed moves the cursor to the next line.
 pub fn linefeed(self: *Terminal) !void {
+    const y = self.screens.active.cursor.y;
     try self.index();
+    // As xterm: a line feed that moves the cursor onto a row below (rather
+    // than scrolling) ends the soft wrap into that row.
+    if (self.screens.active.cursor.y != y) self.screens.active.cursorResetWrapContinuation();
     if (self.modes.get(.linefeed)) self.carriageReturn();
 }
 
@@ -4345,6 +4349,10 @@ pub fn eraseLine(
             // Reset our row's soft-wrap.
             self.screens.active.cursorResetWrap();
 
+            // From the row's first column, as xterm has it: the row no longer
+            // continues the one above it either.
+            if (x == 0) self.screens.active.cursorResetWrapContinuation();
+
             break :right .{ x, self.cols };
         },
 
@@ -4364,6 +4372,7 @@ pub fn eraseLine(
             // rows when resizing. Since we do, the erased row must no longer
             // continue onto the next row.
             self.screens.active.cursorResetWrap();
+            self.screens.active.cursorResetWrapContinuation();
 
             break :complete .{ 0, self.cols };
         },
