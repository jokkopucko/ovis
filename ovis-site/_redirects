# The one-line installers and the browser demo are built with the app into GitHub Pages
# (site/, herdrweb.dev); ovis.sh hands the installers on, so every link can name ovis.sh. The demo
# is fetched from there by _worker.js instead (its routes are in _routes.json), so a visitor stays
# on ovis.sh/demo/.
/install.sh https://herdrweb.dev/install.sh 302
/install.ps1 https://herdrweb.dev/install.ps1 302
# Ovis for Mac: the newest release's signed Ovis.dmg (.github/workflows/mac-dmg.yml attaches it).
/Ovis.dmg https://github.com/devswha/ovis/releases/latest/download/Ovis.dmg 302
# Ovis for Windows: the newest release's Ovis.exe (.github/workflows/windows-app.yml attaches it).
/Ovis.exe https://github.com/devswha/ovis/releases/latest/download/Ovis.exe 302
# The desktop app: the newest release's build for each OS and CPU (.github/workflows/release.yml
# attaches them under these names). Ovis.dmg and Ovis.exe above stay for links to the apps before it.
/Ovis-mac-arm64.dmg https://github.com/devswha/ovis/releases/latest/download/Ovis-mac-arm64.dmg 302
/Ovis-win-x64.exe https://github.com/devswha/ovis/releases/latest/download/Ovis-win-x64.exe 302
/Ovis-mac-x64.dmg https://github.com/devswha/ovis/releases/latest/download/Ovis-mac-x64.dmg 302
/Ovis-linux-x64.deb https://github.com/devswha/ovis/releases/latest/download/Ovis-linux-x64.deb 302
/Ovis-linux-arm64.deb https://github.com/devswha/ovis/releases/latest/download/Ovis-linux-arm64.deb 302
/Ovis-linux-x64.AppImage https://github.com/devswha/ovis/releases/latest/download/Ovis-linux-x64.AppImage 302
/Ovis-linux-arm64.AppImage https://github.com/devswha/ovis/releases/latest/download/Ovis-linux-arm64.AppImage 302
# Addresses people guess for the docs, which live in the repository.
/docs https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/docs/* https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/guide https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/guide/* https://github.com/devswha/ovis/blob/main/docs/guide.md 302
/install https://github.com/devswha/ovis/blob/main/README.md#install 302
/changelog https://github.com/devswha/ovis/blob/main/CHANGELOG.md 302
/faq /#faq 302
# The community Discord: one permanent invite, so every link names ovis.sh/discord and a new invite
# changes this line only.
/discord https://discord.gg/MkK2aSe9Ct 302
# The beta page has Japanese and Chinese pages of its own. Cloudflare follows a rule even where a
# file matches, so these serve them before the /ja/* and /zh/* rules below send the address home.
/ja/beta/ /ja/beta/ 200
/ja/beta /ja/beta/ 301
/zh/beta/ /zh/beta/ 200
/zh/beta /zh/beta/ 301
# The home page reads in Japanese and Chinese through ?lang=, like /ko/.
/ja /?lang=ja 302
/ja/* /?lang=ja 302
/zh /?lang=zh 302
/zh/* /?lang=zh 302
